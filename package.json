{
  "name": "paracosm-provenance-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --port 3497",
    "api": "node scripts/local-api.mjs",
    "scan": "python3 scripts/scan.py",
    "scan:quick": "python3 scripts/scan.py --quick",
    "conform:revised": "python3 scripts/revised_conform.py",
    "conform:clean": "python3 scripts/parse_clean_conform.py",
    "conform:clean-live": "python3 scripts/export_clean_conform_from_prproj.py && python3 scripts/parse_clean_conform.py",
    "shotlist:sync": "python3 scripts/canonical_edl.py",
    "character:build": "node scripts/build-abby-expression-library.mjs",
    "character:render-avatar": "npm run character:render-avatar:blender && npm run character:render-avatar:c4d && npm run character:render-avatar:c4d-lookmatch",
    "character:render-avatar:blender": "\"/Applications/Blender.app/Contents/MacOS/Blender\" -b \"/Users/alphaone/Futuro Dropbox/Futuro Team Folder/Absolutely/ZK/0_Abby_Avatar/1_Blender/1_Abby_For_Retarget_FromUE.blend\" --python scripts/render-abby-avatar-guide.py -- --output-dir public/archive/character-reference/abby/avatar-guide --width 3200 --height 4000",
    "character:render-avatar:c4d": "\"/Applications/Maxon Cinema 4D 2026.1.2/c4dpy.app/Contents/MacOS/c4dpy\" scripts/render-abby-c4d-avatar-guide.py --project \"/Users/alphaone/Futuro Dropbox/Futuro Team Folder/Absolutely/ZK/0_Abby_Avatar/0_C4D/Abby_BaseMesh_Materials.c4d\" --output public/archive/character-reference/abby/avatar-guide/c4d-face-front-4k.png --width 3840 --height 2160 --frame 0",
    "character:prepare-avatar:c4d-lookmatch": "\"/Applications/Maxon Cinema 4D 2026.1.2/c4dpy.app/Contents/MacOS/c4dpy\" \"$PWD/scripts/prepare-abby-c4d-lookmatch.py\" --source \"/Users/alphaone/Futuro Dropbox/Futuro Team Folder/Absolutely/ZK/0_Abby_Avatar/0_C4D/Abby_BaseMesh_Materials.c4d\" --output /tmp/paracosm-abby-lookmatch/abby-redshift-lookmatch.c4d --focal 74.62 --sensor-scale 1.04 --target-x -2.98 --target-y 149.26 --target-z -2.25",
    "character:render-avatar:c4d-lookmatch": "npm run character:prepare-avatar:c4d-lookmatch && \"/Applications/Maxon Cinema 4D 2026.1.2/Commandline.app/Contents/MacOS/Commandline\" -render /tmp/paracosm-abby-lookmatch/abby-redshift-lookmatch.c4d -frame 0 -oimage /tmp/paracosm-abby-lookmatch/abby-redshift-lookmatch.tif -oformat TIFF -oresolution 1280 720 -engine REDSHIFT && python3 scripts/finalize-abby-c4d-lookmatch.py --render /tmp/paracosm-abby-lookmatch/abby-redshift-lookmatch_0000.tif --reference public/archive/character-reference/abby/avatar-guide/c4d-material-closeup-b.png --output public/archive/character-reference/abby/avatar-guide/c4d-redshift-lookmatch.png",
    "alts:search": "OPENCV_IO_ENABLE_OPENEXR=1 python3 scripts/match_revised_alternates.py",
    "resolve:export": "python3 scripts/export_resolve.py",
    "ae:export": "\"/Applications/Adobe After Effects 2026/Adobe After Effects 2026.app/Contents/MacOS/After Effects\" -r \"/Users/alphaone/Documents/Code/paracosm-provenance/scripts/export_after_effects.jsx\"",
    "camera:probe": "python3 scripts/probe_c4d_camera.py",
    "camera:probe-candidates": "python3 scripts/probe_c4d_candidates.py",
    "c4d:dependencies": "python3 scripts/probe_c4d_dependencies.py",
    "audit:c4d-status": "node scripts/audit-c4d-status.mjs",
    "frames:verify": "python3 scripts/verify_frame_pairs.py",
    "proxy:hover": "python3 scripts/build_hover_proxy.py",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:code": "PARACOSM_BUILD_WITHOUT_PUBLIC=1 WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node scripts/dev.mjs --built",
    "test": "npm run build && python3 -m unittest tests/test_canonical_edl.py tests/test_c4d_relink_safety.py && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
